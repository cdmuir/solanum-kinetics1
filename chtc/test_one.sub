# chtc/test_one.sub
# Run this FIRST, before chtc/fit_all.sub, to check timing/memory/disk usage
# for a single model (index 0 == fit_01.rds), and to catch any container or
# data-transfer problems before submitting all 64 jobs.
#
# EDIT <user> below to your CHTC username / staging path before submitting.
#
# After the job finishes:
#   - Check logs/test_0.log for "Memory (MB)" and "Disk (KB)" usage.
#   - Confirm fit_01.rds was transferred back and loads as a brmsfit:
#       Rscript -e 'x <- readRDS("fit_01.rds"); class(x)'
#   - Update request_memory / request_disk in fit_all.sub accordingly.
#
# UPDATE (after first successful test run): actual usage was ~2.3GB memory /
# ~0.8GB disk over a ~17 hour runtime (well under CHTC's 72hr default limit).
# request_memory/request_disk below have been tightened accordingly, with
# roughly 2.5-5x headroom since the other 63 models vary slightly in the
# number of predictors and may use marginally more/less. The job also only
# averaged ~1 of the 3 requested CPUs -- worth checking whether the 3 chains
# actually sampled in parallel once you have a saved fit (see fit$fit$time()
# for per-chain start/end times) before assuming request_cpus = 3 is helping.

container_image = osdf:///chtc/staging/cdmuir/solanum-fit-v2.sif

executable = fit_model.R
arguments  = "0"

transfer_input_files = joined-summary.rds, phylogeny.rds

log    = logs/test_0.log
output = logs/test_0.out
error  = logs/test_0.err

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

requirements = (HasCHTCStaging == true)

request_cpus   = 3
request_memory = 6GB
request_disk   = 4GB

queue 1
